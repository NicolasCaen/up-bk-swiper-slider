{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "up-bk/slick-slider",
  "version": "0.2.0",
  "title": "UP Swiper Slider (drop-in)",
  "category": "media",
  "icon": "slides",
  "description": "Drop-in replacement of UP Slick Slider using Swiper.",
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "color": {
      "background": true,
      "text": true,
      "gradients": true
    },
    "spacing": {
      "padding": true,
      "margin": true
    }
  },
  "attributes": {
    "slides": {"type": "array", "default": []},
    "imageSource": {"type": "string", "default": "gallery"},
    "metaKey": {"type": "string", "default": ""},
    "gap": {"type": "number", "default": 0},
    "fixedHeight": {"type": "boolean", "default": false},
    "slideHeight": {"type": "string", "default": ""},
    "objectFit": {"type": "string", "default": "cover"},
    "imageSize": {"type": "string", "default": "full"},
    "aspectRatio": {"type": "string", "default": "auto"},
    "showFigcaption": {"type": "boolean", "default": false},
    "autoplay": {"type": "boolean", "default": true},
    "autoplaySpeed": {"type": "number", "default": 3000},
    "arrows": {"type": "boolean", "default": true},
    "autoHideArrows": {"type": "boolean", "default": false},
    "arrowType": {"type": "string", "default": "type1"},
    "arrowPosition": {"type": "string", "default": "center"},
    "dots": {"type": "boolean", "default": true},
    "infinite": {"type": "boolean", "default": true},
    "speed": {"type": "number", "default": 500},
    "slidesToShow": {"type": "number", "default": 1},
    "slidesToScroll": {"type": "number", "default": 1},
    "fade": {"type": "boolean", "default": false},
    "centerMode": {"type": "boolean", "default": false},
    "adaptiveHeight": {"type": "boolean", "default": false},
    "pauseOnHover": {"type": "boolean", "default": true},
    "swipe": {"type": "boolean", "default": true},
    "responsive": {"type": "boolean", "default": true},
    "breakpoints": {
      "type": "object",
      "default": {
        "tablet": {
          "breakpoint": 1024,
          "settings": {
            "slidesToShow": 1,
            "slidesToScroll": 1,
            "arrows": true,
            "dots": true,
            "autoplay": true,
            "autoplaySpeed": 3000,
            "infinite": true,
            "speed": 500,
            "fade": false,
            "centerMode": false,
            "adaptiveHeight": false,
            "pauseOnHover": true,
            "swipe": true,
            "gap": 0,
            "fixedHeight": false,
            "slideHeight": "",
            "objectFit": "cover"
          }
        },
        "mobile": {
          "breakpoint": 480,
          "settings": {
            "slidesToShow": 1,
            "slidesToScroll": 1,
            "arrows": false,
            "dots": true,
            "autoplay": true,
            "autoplaySpeed": 3000,
            "infinite": true,
            "speed": 500,
            "fade": false,
            "centerMode": false,
            "adaptiveHeight": false,
            "pauseOnHover": true,
            "swipe": true,
            "gap": 0,
            "fixedHeight": false,
            "slideHeight": "",
            "objectFit": "cover"
          }
        }
      }
    },
    "navIconSize": {"type": "string"},
    "navGap": {"type": "number"},
    "navRadius": {"type": "string"},
    "navPadding": {"type": "number"},
    "insertArrows": {"type": "boolean", "default": true},
    "customPrevClass": {"type": "string", "default": ""},
    "customNextClass": {"type": "string", "default": ""}
  },
  "textdomain": "up-bk-swiper-slider",
  "style": "file:./build/index.css",
  "editorStyle": "file:./build/index.css",
  "editorScript": "file:./build/index.js",
  "viewScript": "file:./build/index.js"
}
